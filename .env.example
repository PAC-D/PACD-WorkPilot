# Local development only. Copy to .env and replace the password.
POSTGRES_DB=workpilot
POSTGRES_USER=workpilot
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
LOCAL_AUTH_ENABLED=true
CURSOR_SECRET=replace-with-a-random-local-cursor-secret
VITE_AUTH_MODE=local

# Hosted environments should normally provide one managed secret instead.
# DATABASE_URL=postgresql://user:password@host:5432/database
# AWS_REGION=eu-north-1
# COGNITO_USER_POOL_ID=eu-north-1_example
# COGNITO_CLIENT_ID=replace-with-public-app-client-id
# S3_UPLOAD_BUCKET=replace-with-private-upload-bucket
# VITE_AUTH_MODE=cognito
# VITE_COGNITO_USER_POOL_ID=eu-north-1_example
# VITE_COGNITO_CLIENT_ID=replace-with-public-app-client-id
# VITE_FILE_UPLOADS_ENABLED=true
# VITE_API_URL=https://api.example.com/api/v1
