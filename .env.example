# Local development only. Copy to .env and replace the password.
POSTGRES_DB=workpilot
POSTGRES_USER=workpilot
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
LOCAL_AUTH_ENABLED=true
CURSOR_SECRET=replace-with-a-random-local-cursor-secret

# Hosted environments should normally provide one managed secret instead.
# DATABASE_URL=postgresql://user:password@host:5432/database
