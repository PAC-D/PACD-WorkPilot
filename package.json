{
  "name": "pacd-workpilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "db:check": "pnpm --filter @pacd/api db:check",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @pacd/api db:migrate",
    "db:seed": "pnpm --filter @pacd/api db:seed",
    "db:up": "docker compose up -d --wait postgres",
    "dev": "pnpm --parallel --filter @pacd/api --filter @pacd/web dev",
    "dev:api": "pnpm --filter @pacd/api dev",
    "dev:web": "pnpm --filter @pacd/web dev",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "test:integration": "pnpm --filter @pacd/api test:integration",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
