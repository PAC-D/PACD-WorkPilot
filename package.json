{
  "name": "pacd-workpilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --filter @pacd/web dev",
    "lint": "pnpm --recursive --if-present lint",
