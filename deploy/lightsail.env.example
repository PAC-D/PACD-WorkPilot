# Copy to deploy/lightsail.env on the server, set chmod 600, and replace every placeholder.
NODE_ENV=production
API_PORT=3000
WEB_ORIGIN=https://registration.pac-d.com
WORKPILOT_WEB_PORT=8080
POSTGRES_DB=workpilot
POSTGRES_USER=workpilot
POSTGRES_PASSWORD=replace-with-a-long-random-secret
CURSOR_SECRET=replace-with-a-different-long-random-secret

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-scoped-runtime-access-key
AWS_SECRET_ACCESS_KEY=replace-with-scoped-runtime-secret-key
COGNITO_USER_POOL_ID=ap-south-1_replace
COGNITO_CLIENT_ID=replace-with-public-app-client-id
S3_UPLOAD_BUCKET=replace-with-private-bucket-name

# One-time bootstrap metadata. Create this exact username in Cognito first, then copy its sub here.
BOOTSTRAP_SUPER_ADMIN_SUB=replace-with-cognito-sub
BOOTSTRAP_SUPER_ADMIN_USERNAME=superadmin
BOOTSTRAP_SUPER_ADMIN_EMPLOYEE_CODE=ADMIN-001
BOOTSTRAP_SUPER_ADMIN_DISPLAY_NAME=Super Admin
# BOOTSTRAP_SUPER_ADMIN_EMAIL=optional@example.com
